# NOCTAVIAE — optional event backend (Supabase). Leave empty for solo play only.
# Both values are public, browser-safe settings (Project URL and the "anon"/publishable key).
# NEVER put the service_role key or any secret here: everything in VITE_* ends up in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development only: set to "false" to hide the in-browser event simulation during `npm run dev`.
VITE_EVENTS_DEV=
